{
  "name": "base-consult-link",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/consult-escrow-parsers.test.ts",
    "test:unit:services": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-services.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/consultation-link-service.test.ts",
    "test:unit:auth": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-auth-guards.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/auth-guards.test.ts",
    "test:unit:auth-nonces": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-auth-nonces.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/auth-nonces-repository.test.ts",
    "test:unit:links-route-compliance": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/links-route-compliance.test.ts",
    "test:unit:funding-compliance": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-funding-compliance.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/funding-compliance.test.ts",
    "test:unit:deal-events": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-deal-events.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/deal-events-service.test.ts",
    "test:unit:compliance-service": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-compliance-service.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/compliance-service.test.ts",
    "test:unit:deals-read": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-deals-read.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/deals-read-service.test.ts",
    "test:unit:deals-completion": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-deals-completion.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/deals-completion-service.test.ts",
    "test:unit:deals-admin": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup-deals-admin.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/deals-admin-service.test.ts",
    "test:unit:admin-denylist": "TS_NODE_PROJECT=tsconfig.test.json node --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/admin-denylist-service.test.ts",
    "test:unit:compliance-plain": "TS_NODE_PROJECT=tsconfig.test.json node --require ./tests/unit/setup.cjs --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/compliance-cache.test.ts ./tests/unit/compliance-display.test.ts ./tests/unit/compliance-providers.test.ts ./tests/unit/create-link-form.test.ts ./tests/unit/link-action-card.test.tsx ./tests/unit/deal-actions-card.test.tsx ./tests/unit/use-funding-flow.test.ts ./tests/unit/use-deal-action.test.ts",
    "test:unit:security": "npm run test:unit:auth && npm run test:unit:auth-nonces && npm run test:unit:deals-read && npm run test:unit:deals-completion && TS_NODE_PROJECT=tsconfig.test.json node --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/unit/timing-safe-secret.test.ts ./tests/unit/pagination-validator.test.ts",
    "test:compliance": "npm run test:unit:links-route-compliance && npm run test:unit:funding-compliance && npm run test:unit:deal-events && npm run test:unit:compliance-service && npm run test:unit:deals-completion && npm run test:unit:deals-admin && npm run test:unit:admin-denylist && npm run test:unit:compliance-plain",
    "test:smoke": "TS_NODE_PROJECT=tsconfig.test.json node --require tsconfig-paths/register --require ts-node/register --test --test-reporter spec ./tests/api/smoke.test.ts",
    "test:contract": "hardhat test",
    "start:worker": "TS_NODE_PROJECT=tsconfig.worker.json DOTENV_CONFIG_PATH=.env.local node --require dotenv/config --require ./server/worker-server-only-shim.js --require tsconfig-paths/register --require ts-node/register server/worker-process.ts",
    "deploy:mock-usdc:base-sepolia": "hardhat run scripts/deploy-mock-usdc.js --network baseSepolia",
    "deploy:escrow:base-sepolia": "hardhat run scripts/deploy-consult-escrow.js --network baseSepolia"
  },
  "dependencies": {
    "@base-org/account": "^2.2.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@supabase/supabase-js": "^2.100.0",
    "@tanstack/react-query": "^5.87.1",
    "lucide-react": "^1.8.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.8.2",
    "viem": "^2.37.3",
    "wagmi": "^2.16.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "dotenv": "^17.4.1",
    "hardhat": "^2.26.3",
    "server-only": "^0.0.1",
    "tsconfig-paths": "^4.2.0"
  }
}
